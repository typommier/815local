# Cloudflare Pages headers.
#
# Assets here are not content-hashed (no build step), so they keep the same URL
# across edits. A long max-age would strand visitors on a stale file after an
# in-place edit (exactly what broke photos once: a cached photo-crop.js kept
# running old logic for a day). Use no-cache so the browser revalidates every
# time; unchanged files still return a cheap 304, so this stays fast while
# guaranteeing an edit shows up on the next load.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://cdn.jsdelivr.net https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: no-cache

/uploads/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  X-Frame-Options: DENY
